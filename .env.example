# Backend
HOST=127.0.0.1
PORT=8000
SEED=42

# Models
EMBEDDER_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GENERATOR_MODEL=HuggingFaceH4/zephyr-7b-beta
MODEL_DTYPE=auto

# Generator backend: "transformers" (local HF weights) or "ollama" (local server)
GENERATOR_BACKEND=transformers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=medgemma:4b
OLLAMA_NUM_CTX=8192
# Set to false for thinking models such as qwen3. Leave unset to use the model default.
# OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT=600

# Corpus and indices
CORPUS_PATH=dataset/medquad_corpus.json
CHUNK_SIZE=300
CHUNK_OVERLAP=50
INDEX_CACHE_DIR=artifacts/index_cache

# Concurrent requests. Keep at 1 on a single GPU.
MAX_CONCURRENT_REQUESTS=1

# Traces contain the raw query and retrieved context. Disable for real data.
PERSIST_TRACES=true
TRACE_DIR=artifacts/production_api
TRACE_RETENTION=200

# Optional abstention threshold on the cross-encoder logit.
# Leave empty until calibrated against your own evaluation set.
MIN_RERANK_SCORE=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUERY_LENGTH=2000
