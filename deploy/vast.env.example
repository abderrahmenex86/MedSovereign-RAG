# Copy this file to .env on the GPU instance. Never commit the real .env.
# 24 GB VRAM: qwen3:14b (Q4, ~9 GB) + embedder + reranker + KV cache.

GENERATOR_BACKEND=ollama
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT=600

HOST=127.0.0.1
PORT=8000
MAX_CONCURRENT_REQUESTS=1
PERSIST_TRACES=false

# The embedder and reranker load on the same CUDA device as the app.
MODEL_DTYPE=auto
